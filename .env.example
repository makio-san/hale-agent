HALE_TARGET_REPO=/absolute/path/to/helio24
HALE_PROVIDER=ollama
HALE_MODEL=qwen2.5:7b
HALE_OLLAMA_HOST=http://127.0.0.1:11434

# Optional
# HALE_MAX_STEPS=12
# HALE_MAX_OUTPUT_TOKENS=2048
# HALE_TOKEN_BUDGET=120000
# HALE_TRACE_DIR=traces
# HALE_ALLOW_TEST_ROLE=0

# Paid alternative. Also: pip install 'hale-agent[anthropic]'
# HALE_PROVIDER=anthropic
# HALE_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=
