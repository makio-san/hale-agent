      "id": "experiment5-v8-accept-validation-recall",
      "kind": "interpret",
      "title": "experiment5 v8 accepted because validation recall met the 0.95 gate",
      "gold_source": "config/experiment5-v8.json development_selection.validation_recall and primary_recall",
      "claims": ["accept_reject_match", "numeric_match", "no_test_leak"],
      "snapshot": {
        "config/experiment5-v8.json": {
          "id": "experiment5",
          "version": 8,
          "status": "development_selection_frozen_test_pending",
          "primary_recall": 0.95,
          "development_data": {"reserved_test_rows": false},
          "acceptance_rule": {
            "description": "Validation recall must stay at least 0.95 before any reserved-test access.",
            "metric_path": "metrics.validation.recall",
            "op": ">=",
            "value": 0.95
          }
        },
        "artifacts/e5_v8/report.json": {
          "protocol": {"id": "experiment5", "status": "development_selection_frozen_test_pending"},
          "metrics": {
            "validation": {
              "recall": 0.9500640204865557,
              "precision": 0.07962227706835498,
              "false_positives": 8577
            },
            "test": {"recall": 0.99, "precision": 0.5}
          }
        }
      },
      "action": {
        "tool": "interpret_result",
        "args": {"protocol": "config/experiment5-v8.json", "artifact": "artifacts/e5_v8"}
      },
      "expect": {
        "decision": "accept",
        "observed": 0.9500640204865557,
        "forbidden_values": [0.99, 0.5]
      },
      "source_locks": [
