          "base": "config/experiment5-v7.json",
          "hypothesis": "Move the reserved test earlier.",
          "acceptance_description": "Validation recall must stay at least 0.95.",
          "metric_path": "metrics.validation.recall",
          "op": ">=",
          "value": 0.95,
          "revision_reason": "A later protocol must not rewrite the frozen role dates.",
          "changes": {
            "roles": {
              "train": ["2010-05-01T00:00:00Z", "2022-01-01T00:00:00Z"],
              "test": ["2023-01-01T00:00:00Z", "2026-01-01T00:00:00Z"]
            }
          }
        }
      },
      "expect": {
        "policy_error": "Cannot change frozen fields"
      }
