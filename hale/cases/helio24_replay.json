    {
      "id": "experiment5-propose-preserves-frozen-contract",
      "kind": "propose",
      "title": "The next experiment5 version keeps roles and leaves reserved test closed",
      "gold_source": "config/experiment5-v7.json and config/experiment5-v8.json share roles and data_contract",
      "claims": ["frozen:roles", "frozen:data_contract", "reserved_test_closed"],
      "snapshot": {
        "config/experiment5-v7.json": {
          "id": "experiment5",
          "version": 7,
          "status": "execution_contract_frozen",
          "data_contract": "swan-sf-v2-contract-v1",
          "question": "M or X GOES flare peak in [forecast_time, forecast_time + 24h)",
          "observation_hours": 12,
          "prediction_hours": 24,
          "time_scale": "UTC",
          "primary_recall": 0.95,
          "development_data": {"reserved_test_rows": false, "features": 96},
          "roles": {
            "train": ["2010-05-01T00:00:00Z", "2022-01-01T00:00:00Z"],
            "calibration": ["2022-01-01T00:00:00Z", "2023-01-01T00:00:00Z"],
            "validation": ["2023-01-01T00:00:00Z", "2024-01-01T00:00:00Z"],
            "test": ["2024-01-01T00:00:00Z", "2026-01-01T00:00:00Z"]
          }
        }
      },
      "action": {
        "tool": "propose_protocol",
        "args": {
          "base": "config/experiment5-v7.json",
          "hypothesis": "Freeze the V2 development selection before any reserved-test access.",
          "acceptance_description": "Validation recall must stay at least 0.95.",
          "metric_path": "metrics.validation.recall",
          "op": ">=",
          "value": 0.95,
          "revision_reason": "Freeze the V2 development selection and its validated operating point before any reserved-test access."
        }
      },
      "expect": {
        "version": 8,
        "status": "design_proposed",
        "reserved_test_rows": false,
        "frozen": {
          "id": "experiment5",
          "data_contract": "swan-sf-v2-contract-v1",
          "question": "M or X GOES flare peak in [forecast_time, forecast_time + 24h)",
          "observation_hours": 12,
          "roles": {
            "train": ["2010-05-01T00:00:00Z", "2022-01-01T00:00:00Z"],
            "calibration": ["2022-01-01T00:00:00Z", "2023-01-01T00:00:00Z"],
            "validation": ["2023-01-01T00:00:00Z", "2024-01-01T00:00:00Z"],
            "test": ["2024-01-01T00:00:00Z", "2026-01-01T00:00:00Z"]
          }
        }
      },
      "source_locks": [
        {
          "path": "config/experiment5-v7.json",
          "pointer": "roles.train.0",
          "equals": "2010-05-01T00:00:00Z"
        },
        {
          "path": "config/experiment5-v8.json",
          "pointer": "roles.train.0",
          "equals": "2010-05-01T00:00:00Z"
        },
        {
          "path": "config/experiment5-v8.json",
          "pointer": "data_contract",
          "equals": "swan-sf-v2-contract-v1"
        }
      ]
    },
